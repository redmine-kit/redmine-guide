#!/usr/bin/env bash
# Takes the guide's screenshots (images/<lang>/<page>/<name>@2x.png) in
# headless Chromium from Redmine 7.0.3 with Redmine's test data, in each
# language (screenshots/screens.rb), then runs bin/convert, which puts them
# into the pages in place of the old ones.
#   bin/screenshots                 # all
#   ONLY=RedmineIssueList bin/screenshots   # the shots whose name matches
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-guide-screenshots
project=redmine-guide-screenshots
compose=(docker compose -f screenshots/compose.yml -p "$project")
"${compose[@]}" up -d --wait >/dev/null
# Its own Compose project, removed afterwards.
trap '"${compose[@]}" down -v >/dev/null 2>&1' EXIT
docker buildx build --load -q -t "$image" -f screenshots/Dockerfile screenshots >/dev/null
# The browser in the chrome container opens the test server of this container
# by its network alias.
docker run --rm --network "${project}_default" --network-alias redmine-guide \
  -e SELENIUM_REMOTE_URL=http://chrome:4444 -e CAPYBARA_SERVER_HOST=0.0.0.0 -e CAPYBARA_SERVER_PORT=3001 \
  -e CAPYBARA_APP_HOST=http://redmine-guide:3001 -e GOOGLE_CHROME_OPTS_ARGS=--headless=new,--force-device-scale-factor=2 \
  -e PARALLEL_WORKERS=1 -e ONLY="${ONLY:-}" -v "$PWD:/guide" "$image" \
  sh -c 'bin/rails db:drop db:create db:migrate >/dev/null && bin/rake test:scm:setup:subversion >/dev/null && bin/rails test /guide/screenshots/screens.rb'
bin/convert
